{
  "name": "techblo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo",
    "dev:all": "concurrently -k -n next,trigger \"bun run dev\" \"bun run trigger:dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "depcruise": "bunx --bun depcruise features lib app shared db components trigger --config .dependency-cruiser.cjs",
    "scaffold:feature": "bun run scripts/scaffold-feature.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "bunx --bun tsc --noEmit",
    "check": "bun run lint && bun run depcruise && bun run typecheck && bun run test:unit",
    "test": "bunx --bun vitest run",
    "test:unit": "bunx --bun vitest run --config vitest.config.ts",
    "test:integration": "bunx --bun vitest run --config vitest.integration.config.ts",
    "test:watch": "bunx --bun vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run scripts/seed.ts",
    "trigger:dev": "bun run scripts/trigger-cli.ts dev",
    "trigger:deploy": "bun run scripts/trigger-cli.ts deploy",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.67",
    "@bprogress/next": "^3.2.12",
    "@heroui/react": "^3.1.0",
    "@heroui/styles": "^3.1.0",
    "@radix-ui/react-collapsible": "^1.1.13",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@trigger.dev/sdk": "^4.4.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.97",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns-tz": "^3.2.0",
    "embla-carousel-react": "^8.6.0",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.8.0",
    "lucide-react": "^1.17.0",
    "motion": "^13.2.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.435.7",
    "postgres": "^3.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "dependency-cruiser": "^18.2.0",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.1.16",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
