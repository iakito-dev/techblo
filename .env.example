# Techblo 環境変数サンプル
# 使い方: cp .env.example .env.local して値を埋める

# ============================================
# Site URL (SEO)
# ============================================
# OGP/canonical/robots/sitemap の絶対 URL の起点。本番で独自ドメインを使う場合は必須。
# 未設定なら Vercel 提供のドメイン(本番は VERCEL_PROJECT_PRODUCTION_URL)にフォールバックする。
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Search Console の所有権確認(HTMLメタタグ方式)のトークン(content 値のみ)。
# 設定すると <meta name="google-site-verification"> が出力される。DNS TXT 方式で確認するなら不要。
GOOGLE_SITE_VERIFICATION=""

# ============================================
# Database (Supabase Postgres / 東京 ap-northeast-1)
# ============================================
# Supabase Dashboard: https://supabase.com/dashboard
# アプリ実行用は Transaction Pooler(port 6543, pgbouncer)を使う。
# drizzle-kit migrate / db:push は Direct 接続(port 5432)を使うこと。
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ============================================
# Better Auth
# ============================================
# 32文字以上のランダム文字列: openssl rand -hex 32
BETTER_AUTH_SECRET="change-me-to-random-32-chars-string"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth: https://github.com/settings/developers (OAuth Apps)
# Authorization callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Discord OAuth: https://discord.com/developers/applications (OAuth2)
# Redirect: {BETTER_AUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ============================================
# Trigger.dev
# ============================================
# https://cloud.trigger.dev/
TRIGGER_SECRET_KEY=""
TRIGGER_PROJECT_REF=""

# ============================================
# Sentry (optional, MVPでは未設定でOK)
# ============================================
# https://sentry.io/
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ============================================
# PostHog (optional, MVPでは未設定でOK)
# ============================================
# https://app.posthog.com/
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ============================================
# Resend (将来のメール機能用)
# ============================================
RESEND_API_KEY=""

# ============================================
# AI記事要約 (ADR-0026, optional)
# ============================================
# Google AI Studio でキー発行: https://aistudio.google.com/apikey
# 未設定なら要約生成は無効(表示側はセクション非表示になるだけでアプリは動く)。
GEMINI_API_KEY=""
# 使用モデル。未設定なら lib/ai のデフォルト(gemini-3.1-flash-lite)。最新IDは AI Studio で確認。
AI_SUMMARY_MODEL="gemini-3.1-flash-lite"
# Trigger.dev の1回あたり生成件数(1〜30)。未設定なら10。
AI_SUMMARY_BATCH_LIMIT="10"
# Trigger.dev の1回あたり記事カテゴリ分類件数(1〜200)。未設定なら50(ADR-0034)。
AI_CATEGORY_BATCH_LIMIT="50"

# ============================================
# Cache revalidation
# ============================================
# 取込 cron(trigger.dev)→ /api/revalidate のフィードキャッシュ即時無効化を保護する共有シークレット。
# 16文字以上のランダム文字列: openssl rand -hex 16
# 本番では Vercel と trigger.dev の両方に同じ値を設定する。未設定だと新着が最大1日反映されない。
REVALIDATE_SECRET=""

# ============================================
# Node environment
# ============================================
# NODE_ENV はここに書かない(Next.js が dev/build で自動設定する)。
# bun --env-file がこれを process env に注入すると、`next build` が
# development の react-dom-server と production の react を混載し、
# /_not-found や /_global-error の prerender が
# 「Cannot read properties of null (reading 'useContext')」で落ちる。
